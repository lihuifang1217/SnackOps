# SnackOps 服务端端口。默认 5000；macOS 的 AirPlay 接收器占用 5000 时请覆盖。
DEPLOY_RUN_PORT=5000

# JSON 数据目录。相对路径基于项目根目录解析；也可使用绝对路径。
# SNACKOPS_DATA_DIR=./data

# Skill 提示词目录。默认 ./skills；隔离测试时使用独立绝对路径。
# SNACKOPS_SKILLS_DIR=./skills

# Provider 选择：classroom-fixture / openai-compatible / coze。
# 未显式选择且没有真实模型凭据时，使用明确标识的 classroom-fixture。
# 显式选择真实 Provider 但缺少配置时返回 503，不会静默降级。
# LLM_PROVIDER=classroom-fixture
# LLM_MODEL=
# LLM_TIMEOUT_MS=20000
# SKILL_TIMEOUT_MS=25000

# OpenAI 兼容接口
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-model-service.example/v1

# Coze LLM
# COZE_API_TOKEN=
# COZE_INTEGRATION_BASE_URL=https://api.coze.com
# COZE_INTEGRATION_MODEL_BASE_URL=https://model.coze.com
